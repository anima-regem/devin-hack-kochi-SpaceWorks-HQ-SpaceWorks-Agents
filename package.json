{
  "name": "@spaceworks-hq/agents",
  "version": "0.1.0",
  "private": true,
  "description": "App discovery, integration and staff operations automation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spaceworks-agents": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve --demo",
    "start": "node dist/cli.js serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
